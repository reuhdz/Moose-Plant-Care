    HOUSEHOLD {
        uuid id PK
        string name
        string timezone
    }
    APP_USER {
        uuid id PK
        uuid household_id FK
        string email UK
        string display_name
    }
    PLANT_CATALOG {
        string slug PK
        string display_name
        string category
        jsonb tips
        jsonb conditions
        jsonb sources
    }
    OWNED_PLANT {
        uuid id PK
        uuid user_id FK
        string catalog_slug FK
        string pot_size
        string current_soil_key FK
        string condition_rating
        boolean repotted
    }
    WATERING_EVENT {
        uuid id PK
        uuid owned_plant_id FK
        date watered_on
        text note
    }
    CONDITION_LOG_ENTRY {
        uuid id PK
        uuid owned_plant_id FK
        date logged_on
        string rating
        text note
    }
